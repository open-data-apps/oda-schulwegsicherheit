{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "oda-schulwegsicherheit",
  "title": "SchulwegSafe Unfallatlas-Datensatz",
  "description": "Von SchulwegSafe ausgewertete Kernfelder des Unfallatlas CSV-Downloads. Eine Zeile entspricht einem erfassten Verkehrsunfall.",
  "fields": [
    {
      "name": "UJAHR",
      "title": "Unfalljahr",
      "type": "integer",
      "description": "Jahr, in dem sich der Unfall ereignet hat.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "UWOCHENTAG",
      "title": "Wochentag",
      "type": "integer",
      "description": "Wochentag nach Unfallatlas-Codierung.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "USTUNDE",
      "title": "Unfallstunde",
      "type": "integer",
      "description": "Stunde des Unfallzeitpunkts (0 bis 23).",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "IstRad",
      "title": "Radverkehr beteiligt",
      "type": "integer",
      "description": "1, wenn Radverkehr beteiligt war, sonst 0.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "IstFuss",
      "title": "Fussverkehr beteiligt",
      "type": "integer",
      "description": "1, wenn Fussverkehr beteiligt war, sonst 0.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "IstKind",
      "title": "Kinder beteiligt",
      "type": "integer",
      "description": "1, wenn Kinder beteiligt waren, sonst 0."
    },
    {
      "name": "XGCSWGS84",
      "title": "Laengengrad",
      "type": "number",
      "description": "Laengengrad des Unfallorts in WGS84.",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "YGCSWGS84",
      "title": "Breitengrad",
      "type": "number",
      "description": "Breitengrad des Unfallorts in WGS84.",
      "constraints": {
        "required": true
      }
    }
  ],
  "missingValues": [""]
}
